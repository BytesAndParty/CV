---
import { DEFAULT_LANG } from '../i18n/config';

// Static fallback for "/". On Netlify, public/_redirects answers "/" server-side first;
// this page covers everything else (bun preview, direct /index.html, other hosts, crawlers).
const defaultPath = `/${DEFAULT_LANG}/`;
---

<!doctype html>
<html lang={DEFAULT_LANG} class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="dark" />
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={defaultPath} />
		<title>Robert Stickler | Portfolio</title>
		<style is:inline>
			/* Background tokens from global.css (--background, default hue 165) */
			html {
				color-scheme: light;
				background: oklch(0.99 0 0);
			}
			html.dark {
				color-scheme: dark;
				background: oklch(0.13 0.01 165);
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				font: 1rem/1.5 system-ui, sans-serif;
			}
		</style>
		<script is:inline define:vars={{ defaultPath }}>
			// Same theme rule as the FOUC script in Layout.astro: dark unless the user chose light
			try {
				if (localStorage.getItem('themeMode') === 'light') {
					document.documentElement.classList.remove('dark');
				}
			} catch {
				// localStorage unavailable - keep the dark default
			}
			// Same language rule as public/_redirects: primary browser language English -> /en/, rest -> default
			const primary = (navigator.languages && navigator.languages[0]) || navigator.language || '';
			const target = primary.toLowerCase().startsWith('en') ? '/en/' : defaultPath;
			// Keep query string and hash, like Netlify's 302 does
			location.replace(target + location.search + location.hash);
		</script>
		<noscript><meta http-equiv="refresh" content={`0;url=${defaultPath}`} /></noscript>
	</head>
	<body>
		<main>
			<a href="/de/" hreflang="de">Deutsch</a> / <a href="/en/" hreflang="en" lang="en">English</a>
		</main>
	</body>
</html>
