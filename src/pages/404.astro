---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Seite nicht gefunden | Robert Stickler">
	<main class="min-h-screen flex items-center justify-center px-4">
		<div class="text-center max-w-lg">
			<p class="text-8xl font-bold mb-6 bg-linear-to-r from-primary via-accent to-primary bg-clip-text text-transparent">
				404
			</p>
			<h1 class="text-2xl font-semibold text-foreground mb-2">
				Seite nicht gefunden
			</h1>
			<p class="text-muted-foreground mb-2">
				Die angeforderte Seite existiert nicht oder wurde verschoben.
			</p>
			<p class="text-muted-foreground/70 text-sm mb-8">
				The page you are looking for does not exist or has been moved.
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<a
					href="/de/"
					class="px-6 py-2.5 rounded-md bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors"
				>
					Zur Startseite
				</a>
				<a
					href="/en/"
					class="px-6 py-2.5 rounded-md border border-primary/50 text-foreground font-medium hover:bg-primary/10 transition-colors"
				>
					Go to homepage
				</a>
			</div>
		</div>
	</main>
</Layout>
